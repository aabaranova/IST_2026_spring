 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Взлом шифра Виженера"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import string\n",
    "from collections import Counter\n",
    "\n",
    "with open('cipher.txt', 'r', encoding='cp1252') as f:\n",
    "    ciphertext = f.read()\n",
    "\n",
    "def extract_letters(text):\n",
    "    return ''.join(ch for ch in text if ch.isalpha())\n",
    "\n",
    "def caesar_shift(text, shift):\n",
    "    res = []\n",
    "    for ch in text:\n",
    "        if ch.isalpha():\n",
    "            base = ord('a') if ch.islower() else ord('A')\n",
    "            res.append(chr((ord(ch) - base + shift) % 26 + base))\n",
    "        else:\n",
    "            res.append(ch)\n",
    "    return ''.join(res)\n",
    "\n",
    "def get_col(text, start, step):\n",
    "    return ''.join(text[i] for i in range(start, len(text), step) if text[i].isalpha())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def ioc(text):\n",
    "    letters = extract_letters(text).lower()\n",
    "    n = len(letters)\n",
    "    if n < 2:\n",
    "        return 0.0\n",
    "    freq = Counter(letters)\n",
    "    return sum(c*(c-1) for c in freq.values()) / (n*(n-1))\n",
    "\n",
    "def find_len(ciphertext, max_len=30):\n",
    "    res = []\n",
    "    for L in range(1, max_len+1):\n",
    "        cols = [get_col(ciphertext, p, L) for p in range(L)]\n",
    "        avg = sum(ioc(c) for c in cols) / L\n",
    "        res.append((L, avg))\n",
    "    res.sort(key=lambda x: x[1], reverse=True)\n",
    "    return [l for l, _ in res[:5]]\n",
    "\n",
    "lengths = find_len(ciphertext)\n",
    "print(\"Возможные длины ключа:\", lengths)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EN_FREQ = {'a':8.167,'b':1.492,'c':2.782,'d':4.253,'e':12.702,\n",
    "           'f':2.228,'g':2.015,'h':6.094,'i':6.966,'j':0.153,\n",
    "           'k':0.772,'l':4.025,'m':2.406,'n':6.749,'o':7.507,\n",
    "           'p':1.929,'q':0.095,'r':5.987,'s':6.327,'t':9.056,\n",
    "           'u':2.758,'v':0.978,'w':2.360,'x':0.150,'y':1.974,'z':0.074}\n",
    "\n",
    "def chi2(text):\n",
    "    letters = extract_letters(text).lower()\n",
    "    n = len(letters)\n",
    "    if n == 0:\n",
    "        return float('inf')\n",
    "    freq = Counter(letters)\n",
    "    return sum((freq.get(ch,0) - n*EN_FREQ[ch]/100)**2 / (n*EN_FREQ[ch]/100) for ch in string.ascii_lowercase)\n",
    "\n",
    "def recover_key(ciphertext, L):\n",
    "    key = ''\n",
    "    for p in range(L):\n",
    "        col = get_col(ciphertext, p, L)\n",
    "        best = min(range(26), key=lambda s: chi2(caesar_shift(col, -s)))\n",
    "        key += chr(best + ord('a'))\n",
    "    return key"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "BIGRAMS = {'th':3.56,'he':3.07,'in':2.43,'er':2.05,'an':1.99,\n",
    "           're':1.85,'on':1.76,'en':1.75,'at':1.49,'es':1.45,\n",
    "           'ed':1.45,'it':1.43,'ou':1.40,'ha':1.30,'to':1.28,\n",
    "           'or':1.28,'is':1.28,'hi':1.27,'ng':1.20,'ar':1.13}\n",
    "\n",
    "def bigram_score(text):\n",
    "    clean = extract_letters(text).lower()\n",
    "    if len(clean) < 2:\n",
    "        return 0.0\n",
    "    bg = [clean[i:i+2] for i in range(len(clean)-1)]\n",
    "    return sum(BIGRAMS.get(b,0) for b in bg) / len(bg)\n",
    "\n",
    "def decrypt(ciphertext, key):\n",
    "    res = []\n",
    "    pos = 0\n",
    "    for ch in ciphertext:\n",
    "        if ch.isalpha():\n",
    "            shift = string.ascii_lowercase.index(key[pos % len(key)])\n",
    "            res.append(caesar_shift(ch, -shift))\n",
    "            pos += 1\n",
    "        else:\n",
    "            res.append(ch)\n",
    "            pos += 1\n",
    "    return ''.join(res)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "seen = set()\n",
    "candidates = []\n",
    "\n",
    "for L in lengths:\n",
    "    key = recover_key(ciphertext, L)\n",
    "    plain = decrypt(ciphertext, key)\n",
    "    score = bigram_score(plain)\n",
    "    \n",
    "    for d in range(1, len(key)//2+1):\n",
    "        if len(key) % d == 0 and key[:d] * (len(key)//d) == key:\n",
    "            key = key[:d]\n",
    "            break\n",
    "    \n",
    "    if key not in seen:\n",
    "        seen.add(key)\n",
    "        candidates.append((score, key, plain))\n",
    "\n",
    "candidates.sort(key=lambda x: x[0], reverse=True)\n",
    "best_score, best_key, best_plain = candidates[0]\n",
    "\n",
    "with open('cracked.txt', 'w', encoding='utf-8') as f:\n",
    "    f.write(best_plain)\n",
    "\n",
    "print(f\"Ключ: {best_key}\")\n",
    "print(f\"Длина ключа: {len(best_key)}\")\n",
    "print(f\"Результат сохранён в cracked.txt\")"
   }
  }
